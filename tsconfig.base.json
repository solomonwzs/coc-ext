{
    "compilerOptions": {
        "target": "ESNext",
        "lib": [
            "es2017",
            "es2018",
            "dom"
        ],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "declaration": false,
        "sourceMap": true,
        "outDir": "lib",
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "noImplicitAny": false,
        "esModuleInterop": true
    }
}
